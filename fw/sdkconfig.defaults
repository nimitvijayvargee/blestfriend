# Bluetooth Classic only (A2DP source + AVRCP), BLE off to save RAM.
# Key names follow ESP-IDF 5.x; confirm them in `idf.py menuconfig` after
# the first build if the build warns about unknown symbols.
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_SSP_ENABLED=y

# Larger main stack for the I2C command task and Bluetooth callbacks.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
